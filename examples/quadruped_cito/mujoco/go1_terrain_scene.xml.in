<mujoco model="ContactIPM Go1 terrain scene">
  <include file="@MUJOCO_GO1_XML@"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <hfield name="cito_heightfield" nrow="257" ncol="257" size="2 2 0.5 0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="cito_terrain" type="hfield" hfield="cito_heightfield"
          pos="0 0 -0.25"
          friction="0.8 0.02 0.01" rgba="0.2 0.3 0.4 1"/>
  </worldbody>
</mujoco>
